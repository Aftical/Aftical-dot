{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/Aftical/.config/Aftical-dot/fastfetch/bocchi-transparent.png",
        "width": 28,
        "padding": {
            "left": 3,
            "top": 1
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│           │\u001b[11D\u001b[31m user    \u001b[33m│", 
            "type": "title",
            "format": "{1}"
        },
        {
            "key": "│           │\u001b[11D\u001b[32m󰇅 hname   \u001b[33m│",
            "type": "title",
            "format": "{2}"
        },
        {
            "key": "│           │\u001b[11D\u001b[33m󰅐 uptime  \u001b[33m│",
            "type": "uptime"
        },
        {
            "key": "│           │\u001b[11D\u001b[34m󰟾 distro  \u001b[33m│",
            "type": "os"
        },
        {
            "key": "│           │\u001b[11D\u001b[35m kernel  \u001b[33m│",
            "type": "kernel"
        },
        {
            "key": "│           │\u001b[11D\u001b[36m󰇄 window  \u001b[33m│",
            "type": "wm"
        },
        {
            "key": "│           │\u001b[11D\u001b[36m󰇄 desktop \u001b[33m│",
            "type": "de"
        },
        {
            "key": "│           │\u001b[11D\u001b[31m term    \u001b[33m│",
            "type": "terminal"
        },
        {
            "key": "│           │\u001b[11D\u001b[32m shell   \u001b[33m│",
            "type": "shell"
        },
        {
            "key": "│           │\u001b[11D\u001b[33m󰍛 cpu     \u001b[33m│",
            "type": "cpu"
        },
        {
            "key": "│           │\u001b[11D\u001b[34m󰉉 disk    \u001b[33m│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│           │\u001b[11D\u001b[35m memory  \u001b[33m│",
            "type": "memory"
        },
        {
            "key": "│           │\u001b[11D\u001b[36m swap    \u001b[33m│",
            "type": "swap"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│            \u001b[11D\u001b[m colors  \u001b[33m│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
